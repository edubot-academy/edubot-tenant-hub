# Public Vite env vars. These values are bundled into the client.

# Backend API base URL. Required for real backend mode.
VITE_API_BASE_URL=http://localhost:4000

# Optional explicit backend toggle. Usually unnecessary if VITE_API_BASE_URL is set.
VITE_ENABLE_BACKEND_API=true

# Auth mode:
# - leave unset for token-based auth
# - set to "cookie" for cookie/session auth
VITE_AUTH_SESSION_MODE=

# Legacy alternative to VITE_AUTH_SESSION_MODE=cookie.
VITE_USE_COOKIE_AUTH=false

# Enable GET /me/context when the backend supports it.
VITE_USE_APP_CONTEXT_ENDPOINT=false

# Comma-separated hostnames that should be treated as non-tenant hosts.
# Example: localhost,127.0.0.1,my-app.vercel.app
VITE_TENANT_NEUTRAL_HOSTS=

# Optional base domain for ?tenant=<slug> expansion.
# Example: with edubot.it.com, ?tenant=acme resolves as acme.edubot.it.com
VITE_TENANT_QUERY_BASE_DOMAIN=
